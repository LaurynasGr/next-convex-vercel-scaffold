# Copy to .env.local and fill in. `bunx convex dev` (run from apps/web) writes both automatically.

# Which Convex deployment `convex dev` pushes functions to, e.g. anonymous:anonymous-web or dev:some-name-123
CONVEX_DEPLOYMENT=

# The client-side Convex URL, inlined into the frontend bundle, e.g. http://127.0.0.1:3210 or https://some-name-123.convex.cloud
NEXT_PUBLIC_CONVEX_URL=
