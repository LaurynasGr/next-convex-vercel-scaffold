{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["node", "react", "react-dom"],
        "jsx": "preserve",
        "incremental": true,
        "plugins": [{ "name": "next" }],
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["next-env.d.ts", "src", "next.config.ts", ".next/types/**/*.ts"],
    "exclude": ["node_modules", ".next"]
}
